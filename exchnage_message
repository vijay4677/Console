5. job_common_service/namespace.py
These are the two GET endpoints exposed by FYPO.
from flask import requestfrom flask_restx import Namespace, Resource, fieldsfrom .client import create_clientsfrom .service import JobService, JobServiceErrorjob_common_service_namespace = Namespace(    "jobs",    description="Job status and results",)job_service = JobService(create_clients())job_response = job_common_service_namespace.model(    "Job",    {        "jobId": fields.String(required=True),        "service": fields.String(required=True),        "jobType": fields.String,        "status": fields.String(required=True),        "input": fields.Raw,        "output": fields.Raw,        "error": fields.Raw,        "createdAt": fields.String,        "startedAt": fields.String,        "completedAt": fields.String,    },)job_list_response = job_common_service_namespace.model(    "JobList",    {        "items": fields.List(fields.Nested(job_response)),        "total": fields.Integer,        "page": fields.Integer,        "pageSize": fields.Integer,    },)def error_response(exc):    return {"message": str(exc)}, exc.status_code@job_common_service_namespace.route("")class JobListResource(Resource):    @job_common_service_namespace.doc(        params={            "service": "Required: inflow or outflow",            "status": "Optional job status, e.g. RUNNING",            "page": "Page number, starting at 1",            "page_size": "Page size, 1..100",        }



One Flask-RESTX detail: if you want consistent error response schemas in Swagger, define a shared error model and document the 400, 404, and 502 responses with @doc or @response. The current code returns the appropriate status codes but doesn't yet document every error model in the API specification.
